#!/bin/sh

# 1. Install age if missing (needed for the next step)
if ! command -v age >/dev/null; then
    sudo apt-get update && sudo apt-get install -y age
fi

# 2. Decrypt the key
if [ ! -f "$HOME/.config/chezmoi/key.txt" ]; then
    mkdir -p "$HOME/.config/chezmoi"
    echo "🔑 Enter passphrase to decrypt age key:"
    age -d -o "$HOME/.config/chezmoi/key.txt" "{{ .chezmoi.sourceDir }}/key.txt.age"
fi
