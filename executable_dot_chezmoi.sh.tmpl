#!/bin/sh

# 1. Install dependencies based on OS
if ! command -v age >/dev/null || ! command -v curl >/dev/null; then
  echo "📦 Installing dependencies..."
  if [ "$(uname)" = "Linux" ]; then
    sudo apt-get update && sudo apt-get install -y age curl
  elif [ "$(uname)" = "Darwin" ]; then
    brew install age curl
  fi
fi

# 2. Setup the config directory
mkdir -p "$HOME/.config/chezmoi"

# 3. Decrypt the age key (if it doesn't exist)
if [ ! -f "$HOME/.config/chezmoi/key.txt" ]; then
  echo "🔑 Decrypting private key..."
  # This uses the sourceDir variable from chezmoi to find your encrypted key
  age -d -o "$HOME/.config/chezmoi/key.txt" "{{ .chezmoi.sourceDir }}/key.txt.age"
fi
